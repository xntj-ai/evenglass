# Copy to .env on the server (chmod 600) and fill in real values.
# Never commit the real .env — it's in .gitignore.

# === Required ===

# Phoenix session/cookie signing key.
# Generate: docker run --rm hexpm/elixir:1.18.4-erlang-27.3.4-debian-bookworm-20250520-slim \
#           sh -c "mix local.hex --force >/dev/null && mix phx.gen.secret"
SECRET_KEY_BASE=

# BEAM distribution cookie (for `bin/evenglass remote` etc).
# Must be stable across container restarts, otherwise iex/remote sessions fail.
# Generate: openssl rand -base64 48 | tr '+/' '-_' | tr -d '='
RELEASE_COOKIE=

# Postgres password for the `evenglass` user.
# Generate: openssl rand -base64 32 | tr -d '=+/' | cut -c1-32
POSTGRES_PASSWORD=

# === Optional (defaults shown) ===

# PHX_HOST=g2.xntj.tv
# PORT=4000
# POOL_SIZE=10
